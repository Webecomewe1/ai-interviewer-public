# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Voice turn-ending tolerance (ms of silence before end-of-speech is committed)
GEMINI_LIVE_SILENCE_MS=5000
# end-of-speech sensitivity: low (tolerant of pauses) or high
GEMINI_LIVE_END_SENSITIVITY=low

# Server
PORT=3000

# ===== MongoDB =====
# Connection string for your MongoDB instance (local or Atlas).
# Local example:  mongodb://127.0.0.1:27017/ai-interviewer
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-interviewer
MONGO_URI=mongodb://127.0.0.1:27017/ai-interviewer

# ===== Auth =====
# Secret used to sign JWTs issued after login/signup. Choose a long random string.
JWT_SECRET=change_me_to_a_long_random_string

# Public origin of the frontend.
WEB_URL=http://localhost:5173
# Public origin of the backend.
BACKEND_URL=http://localhost:3000

# ===== Email (Resend) =====
# Get your API key from https://resend.com/api-keys
# For development, leave empty to log OTP to console instead of sending email
RESEND_API_KEY=
# Verified sender email (use onboarding@resend.dev for testing, or your verified domain)
RESEND_FROM_EMAIL=onboarding@resend.dev