# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Voice turn-ending tolerance (ms of silence before end-of-speech is committed)
GEMINI_LIVE_SILENCE_MS=5000
# end-of-speech sensitivity: low (tolerant of pauses) or high
GEMINI_LIVE_END_SENSITIVITY=low

# Server
PORT=3000
WEB_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Abuse protection. Do not set TRUST_PROXY=true or trust a hop count.
# Leave empty for direct hosting. Behind a proxy, list only its trusted IPs/CIDRs.
# Example for a reverse proxy on the same machine: TRUST_PROXY=loopback
TRUST_PROXY=
INTERVIEW_STARTS_PER_HOUR=10
AI_REQUESTS_PER_ACCOUNT_DAY=200
AI_CALLS_PER_DAY=1000
VOICE_SESSIONS_PER_ACCOUNT_DAY=4
VOICE_SESSIONS_PER_DAY=50
VOICE_MAX_MINUTES=15
# Use NODE_ENV=production in production. Shared MongoDB quotas fail closed when
# MongoDB is unavailable; development without MongoDB uses process-local quotas.

# ===== MongoDB =====
# Connection string for your MongoDB instance (local or Atlas).
# Local example:  mongodb://127.0.0.1:27017/ai-interviewer
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-interviewer
MONGO_URI=mongodb://127.0.0.1:27017/ai-interviewer

# ===== Auth =====
# Secret used to sign JWTs issued after login/signup. Choose a long random string.
JWT_SECRET=change_me_to_a_long_random_string

# Public origin of the frontend.
WEB_URL=http://localhost:5173
# Public origin of the backend.
BACKEND_URL=http://localhost:3000

# ===== Email (EmailJS) =====
# Used for email verification OTPs and password reset codes.
# Create a service + template at https://www.emailjs.com/
# Template variables available: email, to_email, user_email, recipient, verification_code, reset_code
# For development, leave empty to log OTP codes to the backend console instead of sending email.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
